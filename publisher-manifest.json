          "version": 3,
          "body": "\n\n\n\n\n\n\n\n<style>\n  :root{--ink:#141416;--muted:#5f6167;--line:#d9d3cb;--orange:#ff5a00;--orange-soft:#ffe9dc;--paper:#ffffff;--sand:#f7f3ee}\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{margin:0;background:var(--paper);color:var(--ink);font-family:\"Helvetica Neue\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.75}\n  a{color:inherit}\n  .wrap{width:100%;max-width:1080px;margin:0 auto;padding:0 22px}\n\n  /* ===== 首屏：全宽色带分层堆叠 ===== */\n  .band{width:100%}\n  .band-a{background:var(--orange);color:#fff}\n  .band-b{background:var(--sand)}\n  .band-c{background:var(--ink);color:#fff}\n\n  .hero-top{padding:46px 0 38px}\n  .eyebrow{display:inline-block;font-size:13px;letter-spacing:.22em;text-transform:uppercase;border:1px dashed rgba(255,255,255,.75);padding:5px 12px;margin:0 0 24px}\n  h1{margin:0;font-size:clamp(46px,10vw,104px);line-height:.98;letter-spacing:-.03em;font-weight:800}\n  .hero-sub{margin:22px 0 0;max-width:34em;font-size:clamp(16px,2.2vw,19px);line-height:1.7;color:#fff7f2}\n  .jump{margin:30px 0 0;display:flex;flex-wrap:wrap;gap:10px 12px;padding:0;list-style:none}\n  .jump a{display:inline-block;text-decoration:none;font-size:14px;padding:8px 14px;border:1px solid rgba(255,255,255,.7);border-radius:999px;background:rgba(255,255,255,.10)}\n  .jump a:hover{background:#fff;color:var(--orange);border-color:#fff}\n\n  .hero-mid{padding:34px 0 40px}\n  .hero-mid-grid{display:grid;grid-template-columns:1fr;gap:26px}\n  .lede{margin:0;font-size:17px;max-width:38em;color:#26262a}\n  .lede strong{background:var(--orange-soft);padding:0 4px}\n  .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:2px solid var(--ink)}\n  .facts div{padding:14px 8px 4px 0;border-right:1px dashed var(--line)}\n  .facts div:last-child{border-right:0}\n  .facts dt{font-size:12px;letter-spacing:.12em;color:var(--muted);margin:0}\n  .facts dd{margin:4px 0 0;font-size:19px;font-weight:700;letter-spacing:-.01em}\n\n  .hero-foot{padding:20px 0 22px}\n  .hero-foot p{margin:0;font-size:14px;color:#cfcdc9;max-width:62em}\n  .hero-foot strong{color:#fff}\n\n  /* ===== 通用区块 ===== */\n  section{padding:64px 0}\n  .sec-head{display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:34px;border-bottom:2px solid var(--ink);padding-bottom:14px}\n  .sec-num{font-size:12px;letter-spacing:.2em;color:var(--orange);font-weight:700}\n  h2{margin:0;font-size:clamp(25px,4.4vw,36px);line-height:1.22;letter-spacing:-.02em}\n  .sec-note{margin:0;color:var(--muted);font-size:15px;max-width:44em}\n\n  /* ===== 票据卡片（虚线框） ===== */\n  .ticket{border:2px dashed var(--ink);background:#fff;padding:20px 20px 18px;border-radius:4px}\n  .ticket h3{margin:0 0 6px;font-size:19px;letter-spacing:-.01em}\n\n  /* ===== 使用说明 ===== */\n  .steps{display:grid;grid-template-columns:1fr;gap:16px;counter-reset:step}\n  .step{position:relative;padding-left:0}\n  .step .no{display:block;font-size:12px;font-weight:700;letter-spacing:.18em;color:var(--orange);margin-bottom:6px}\n  .step p{margin:0;font-size:15px;color:#33333a}\n  .step p + p{margin-top:8px}\n\n  .prepare{margin-top:34px;display:grid;grid-template-columns:1fr;gap:14px}\n  .prepare ul{margin:0;padding-left:1.15em}\n  .prepare li{margin:0 0 7px;font-size:15px}\n  .prepare li:last-child{margin-bottom:0}\n\n  /* ===== 套餐对比表 ===== */\n  .table-scroll{overflow-x:auto;border:2px dashed var(--ink);border-radius:4px;background:#fff;-webkit-overflow-scrolling:touch}\n  table{width:100%;min-width:660px;border-collapse:collapse;font-size:15px}\n  caption{text-align:left;padding:16px 18px 4px;font-size:13px;color:var(--muted)}\n  th,td{padding:14px 16px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}\n  thead th{background:var(--sand);font-size:14px;border-bottom:2px solid var(--ink);white-space:nowrap}\n  thead th.is-featured{background:var(--orange);color:#fff}\n  tbody th{font-weight:600;font-size:14px;color:#3a3a40;white-space:nowrap;background:#fdfcfa}\n  tbody tr:last-child th,\n  tbody tr:last-child td{border-bottom:0}\n  .price{display:block;font-size:23px;font-weight:800;letter-spacing:-.02em;line-height:1.25}\n  .price small{font-size:13px;font-weight:500;color:var(--muted)}\n  .annual{display:block;font-size:13px;color:var(--muted);margin-top:4px}\n  .tag{display:inline-block;font-size:11px;letter-spacing:.12em;border:1px solid currentColor;padding:1px 7px;border-radius:999px;margin-top:6px}\n  td ul{margin:0;padding-left:1.1em}\n  td li{margin:0 0 5px}\n  td li:last-child{margin-bottom:0}\n  .table-foot{margin:16px 0 0;font-size:14px;color:var(--muted);max-width:60em}\n\n  /* ===== 客户端区块 ===== */\n  .clients{display:grid;grid-template-columns:1fr;gap:16px}\n  .clients p{margin:0;font-size:15px;color:#33333a}\n  .clients .hint{font-size:14px;color:var(--muted);border-top:1px dashed var(--line);padding-top:12px;margin-top:12px}\n\n  /* ===== FAQ 双栏 ===== */\n  .faq-grid{display:grid;grid-template-columns:1fr;gap:16px}\n  .qa{border-top:2px solid var(--ink);padding-top:14px}\n  .qa h3{margin:0 0 8px;font-size:16px;line-height:1.5}\n  .qa h3 .q{color:var(--orange);font-weight:800;margin-right:6px}\n  .qa p{margin:0;font-size:15px;color:#33333a}\n\n  /* ===== 页脚 ===== */\n  footer{background:var(--ink);color:#b9b7b3;padding:44px 0 52px;font-size:14px}\n  footer .wrap{display:grid;gap:18px}\n  footer strong{color:#fff}\n  footer p{margin:0;max-width:60em}\n  .foot-links{display:flex;flex-wrap:wrap;gap:8px 18px;padding:0;margin:0;list-style:none;font-size:14px}\n  .foot-links a{color:#fff;text-decoration:none;border-bottom:1px dashed rgba(255,255,255,.5)}\n  .foot-links a:hover{color:var(--orange);border-color:var(--orange)}\n\n  @media (min-width:760px){\n    .hero-mid-grid{grid-template-columns:1.35fr 1fr;gap:40px;align-items:start}\n    .sec-head{grid-template-columns:1fr auto;align-items:end}\n    .sec-head .sec-note{text-align:right;max-width:26em}\n    .steps{grid-template-columns:repeat(2,1fr);gap:18px}\n    .prepare{grid-template-columns:1fr 1fr;gap:20px}\n    .clients{grid-template-columns:1fr 1fr}\n    .faq-grid{grid-template-columns:1fr 1fr;gap:22px 40px}\n  }\n  @media (min-width:1000px){\n    .steps{grid-template-columns:repeat(4,1fr)}\n  }\n</style>\n\n\n<main>\n\n  <div class=\"band band-a\">\n    <div class=\"wrap hero-top\">\n      <p class=\"eyebrow\">套餐 / 使用 / 问答</p>\n      <h1>双骑</h1>\n      <p class=\"hero-sub\">三档套餐、一份使用清单、一页常见问题。价格和权益都摆在同一张表里，先看清楚再决定，不必来回翻页面。</p>\n      <ul class=\"jump\">\n        <li><a href=\"#howto\">怎么用：四步清单</a></li>\n        <li><a href=\"#plans\">套餐横向对比</a></li>\n        <li><a href=\"#clients\">客户端准备</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </div>\n  </div>\n\n  <div class=\"band band-b\">\n    <div class=\"wrap hero-mid\">\n      <div class=\"hero-mid-grid\">\n        <p class=\"lede\">这份页面只做一件事：把双骑的<strong>月付与年付价格、每档的流量与设备数、以及开通后要做的操作</strong>写成可以直接照着走的说明。套餐按人数和用量分档，年付按十个月计价，差额写在旁边，不藏在细则里。</p>\n        <dl class=\"facts\">\n          <div>\n            <dt>套餐档位</dt>\n            <dd>3 档</dd>\n          </div>\n          <div>\n            <dt>起步月费</dt>\n            <dd>¥15 起</dd>\n          </div>\n          <div>\n            <dt>设备上限</dt>\n            <dd>3 / 5 / 20 台</dd>\n          </div>\n        </dl>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"band band-c\">\n    <div class=\"wrap hero-foot\">\n      <p><strong>先看用量，再看价格。</strong>一个人的手机加电脑，基础版够用；家里多台设备、还想兼顾流媒体和游戏线路，看旗舰版；多人共用或需要定制路由，直接看团队版。</p>\n    </div>\n  </div>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"sec-num\">01 / 使用说明</p>\n          <h2>开通之后，按这四步走</h2>\n        </div>\n        <p class=\"sec-note\">顺序别打乱：先确定档位，再准备设备，最后才去调线路。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step ticket\">\n          <span class=\"no\">STEP 01</span>\n          <h3>挑一档适合当前用量的套餐</h3>\n          <p>先数清楚同时在线的设备：手机、笔记本、平板、电视盒子都算一台。设备数卡在档位上限附近时，往上选一档比事后加设备省事。</p>\n          <p>流量按整月累计，选档时留出大约两成余量。</p>\n        </article>\n        <article class=\"step ticket\">\n          <span class=\"no\">STEP 02</span>\n          <h3>把要用的设备列出来</h3>\n          <p>在纸上或备忘录里写上每台设备的系统名称，接下来配置时按设备逐一核对，避免装完才发现漏了一台。</p>\n          <p>共用账号的家庭或小团队，先指定一名管理设备的人。</p>\n        </article>\n        <article class=\"step ticket\">\n          <span class=\"no\">STEP 03</span>\n          <h3>按设备类型完成客户端配置</h3>\n          <p>每台设备装好对应客户端后，用同一份订阅信息完成配置。配置成功后先做一次简单连通测试，再谈速度。</p>\n          <p>具体安装位置以下载来源页面的说明为准，不要从第三方转存渠道取安装包。</p>\n        </article>\n        <article class=\"step ticket\">\n          <span class=\"no\">STEP 04</span>\n          <h3>根据用途调整线路与设备配额</h3>\n          <p>日常浏览用默认线路即可；看视频和玩游戏时再换到更合适的线路。改动后观察一段时间，记录哪条线路在哪个时段更稳。</p>\n          <p>配额用完前，提前决定是升档还是等下一个周期。</p>\n        </article>\n      </div>\n\n      <div class=\"prepare\">\n        <div class=\"ticket\">\n          <h3>开始前需要准备</h3>\n          <ul>\n            <li>一台能正常上网的设备，用来查看订阅信息。</li>\n            <li>清楚的设备清单，含系统与数量。</li>\n            <li>一个长期在用的邮箱，便于接收变更说明。</li>\n            <li>一段不被打断的十分钟，用来完成首次配置。</li>\n          </ul>\n        </div>\n        <div class=\"ticket\">\n          <h3>使用中建议遵守</h3>\n          <ul>\n            <li>同一账号只在已选档位的设备数内使用。</li>\n            <li>线路变更后做一次连通测试，确认无误再继续。</li>\n            <li>团队共用时，把使用人和设备对应关系记录下来。</li>\n            <li>遇到问题先记录时间、设备、线路三要素，再提交工单。</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"sec-num\">02 / 套餐</p>\n          <h2>三档套餐，一张表看完</h2>\n        </div>\n        <p class=\"sec-note\">月付与年付并列，年付按十个月计价，不额外赠送月数。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table>\n          价格与权益对照，实际扣费以结算页展示为准。\n          <thead>\n            <tr>\n              <th>项目</th>\n              <th>基础版</th>\n              <th class=\"is-featured\">旗舰版</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15<small> / 月</small></span></td>\n              <td><span class=\"price\">¥35<small> / 月</small></span><span class=\"tag\">推荐</span></td>\n              <td><span class=\"price\">¥85<small> / 月</small></span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td><span class=\"price\">¥150<small> / 年</small></span><span class=\"annual\">按月付折算约 ¥12.5 / 月</span></td>\n              <td><span class=\"price\">¥350<small> / 年</small></span><span class=\"annual\">按月付折算约 ¥29.2 / 月</span></td>\n              <td><span class=\"price\">¥850<small> / 年</small></span><span class=\"annual\">按月付折算约 ¥70.8 / 月</span></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td>300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路与解锁</th>\n              <td>\n                <ul>\n                  <li>普通线路节点池</li>\n                  <li>基础流媒体解锁</li>\n                </ul>\n              </td>\n              <td>\n                <ul>\n                  <li>全节点原生流媒体解锁</li>\n                  <li>IPLC 专线游戏加速优化</li>\n                </ul>\n              </td>\n              <td>\n                <ul>\n                  <li>VIP 专属高带宽节点</li>\n                  <li>支持企业定制路由</li>\n                </ul>\n              </td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>标准工单支持</td>\n              <td>7x24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>个人一到两台设备，日常浏览为主</td>\n              <td>多设备共用，兼顾流媒体与游戏</td>\n              <td>多人团队或需要固定路由的场合</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"table-foot\">说明：套餐权益按档位划分，升档与降档在计费周期切换时处理更为稳妥；对用量没有把握时，先按月付试一个周期，再决定是否改年付。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"sec-num\">03 / 客户端</p>\n          <h2>客户端：先备齐，再动手</h2>\n        </div>\n        <p class=\"sec-note\">双骑不在此页面分发安装包，安装包以各客户端官方发布页为准。</p>\n      </div>\n\n      <div class=\"clients\">\n        <div class=\"ticket\">\n          <h3>按设备的准备方式</h3>\n          <p>手机、平板与桌面设备分别使用对应系统的客户端；电视与路由器类设备通常走同一份订阅信息完成配置。若某台设备找不到合适的客户端，先把它从本期设备清单里划掉，再决定是否调整档位。</p>\n          <p class=\"hint\">本页不提供下载地址，也不代为分发安装文件。</p>\n        </div>\n        <div class=\"ticket\">\n          <h3>配置时容易忽略的三点</h3>\n          <p>一，订阅信息属于账号凭据，不要把截图发到公开群组。二，同档位内的设备数上限是同时在线数量，不是累计安装数量。三，每次更换线路后重做一次连通测试，比凭感觉判断更可靠。</p>\n          <p class=\"hint\">具体参数项名称以客户端界面为准，本页不做逐项罗列。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"sec-num\">04 / 常见问题</p>\n          <h2>常见问题，双栏并排</h2>\n        </div>\n        <p class=\"sec-note\">左栏偏选购，右栏偏使用。答案尽量短，能落到操作上就落到操作上。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>三档套餐最该比较哪一项？</h3>\n          <p>先比同时在线设备数，再比每月流量。设备数决定了你会不会频繁挤下别人，流量决定了月底会不会被限速；价格放在这两项之后看。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>年付比月付省多少？</h3>\n          <p>三档都是按十个月计价：基础版 ¥150、旗舰版 ¥350、团队版 ¥850，比连续十二个月月付少付两个月。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>只用一台手机，需要选旗舰版吗？</h3>\n          <p>通常不必。基础版每月 100GB 与 3 台设备已覆盖单人或双人日常使用；只有当常用流媒体、游戏线路或设备数量超出基础版范围时，升到旗舰版才划算。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>团队版的定制路由指什么？</h3>\n          <p>这是团队版列表中的一项权益，具体可配置的范围与申请方式不在本页展开。建议在购买前通过工单说明使用场景，由支持方确认后再决定。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>第一次配置一般要多久？</h3>\n          <p>单台设备通常几分钟内完成，前提是设备清单和订阅信息都已准备好。设备越多，建议分批配置，每配完一批就做一次连通测试。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>设备换新了，配额怎么算？</h3>\n          <p>同档位限制的是同时在线数量。旧设备退出后，新设备接入即可；不需要为单台设备的更换重新选档，但要把旧设备从常用清单里删掉。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>流量提前用完会怎样？</h3>\n          <p>本页不承诺任何自动处理方式。稳妥做法是提前一周查看用量，决定升档还是等下一个计费周期开始；需要确认时请提交工单，以实际答复为准。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>从哪获取客户端安装包？</h3>\n          <p>以各客户端官方发布页为准。本页不提供下载地址，也不建议从第三方转存渠道获取安装文件，来路不明的安装包风险由使用者承担。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>提交工单前要准备什么？</h3>\n          <p>三样：发生问题的时间、涉及的设备与系统、当时使用的线路。带上这三项，往返沟通会明显减少。旗舰版与团队版的支持优先级不同，按所选档位提交即可。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>能不能先短期试一档再换？</h3>\n          <p>可以先按月付使用一个完整周期，观察真实用量后再改年付。换档安排在计费周期切换时处理，账目更清楚；本页不对退款作任何说明，如涉及请以工单答复为准。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p><strong>双骑</strong> · 套餐、使用说明与常见问题集中在本页。价格与权益以本页表格为准，实际扣费以结算页展示为准。</p>\n    <ul class=\"foot-links\">\n      <li><a href=\"#howto\">回到使用说明</a></li>\n      <li><a href=\"#plans\">回到套餐对比</a></li>\n      <li><a href=\"#clients\">回到客户端</a></li>\n      <li><a href=\"#faq\">回到常见问题</a></li>\n    </ul>\n    <p>本页不提供安装包下载，不代发安装文件；涉及账号与配置的问题，建议整理好时间、设备、线路三项信息后提交工单。</p>\n  </div>\n</footer>\n\n",
